{
  "name": "spherail",
  "version": "0.1.4",
  "description": "Spherail / 绘轨 — offline 2D and 3D arcade puzzle game",
  "author": "rrrome and contributors",
  "main": "Windows/main.cjs",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build:3d": "node scripts/build_3d.mjs",
    "test:3d": "node --test Tests/JavaScript/*.test.mjs",
    "start": "electron .",
    "test": "node --test Tests/JavaScript/*.test.mjs Tests/Windows/*.test.cjs",
    "test:windows": "node scripts/smoke_windows.mjs",
    "build:windows": "node scripts/build_windows.mjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "three": "0.164.1"
  }
}
